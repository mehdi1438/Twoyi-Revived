<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_category_basic">
        <Preference
            android:key="@string/settings_key_import_app"
            android:summary="@string/settings_import_summary"
            android:title="@string/settings_key_import_app" />

        <Preference
            android:key="@string/settings_key_manage_files"
            android:summary="@string/settings_export_summary"
            android:title="@string/settings_key_manage_files" />

        <Preference
            android:key="@string/settings_key_shutdown"
            android:title="@string/settings_key_shutdown" />

        <Preference
            android:key="@string/settings_key_reboot"
            android:title="@string/settings_key_reboot" />
    </PreferenceCategory>


    <PreferenceCategory android:title="@string/settings_category_display">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/settings_key_custom_resolution"
            android:summary="@string/settings_custom_resolution_summary"
            android:title="@string/settings_custom_resolution_title" />

        <EditTextPreference
            android:dependency="@string/settings_key_custom_resolution"
            android:dialogTitle="@string/settings_display_width_title"
            android:inputType="number"
            android:key="@string/settings_custom_width_key"
            android:title="@string/settings_display_width_title" />

        <EditTextPreference
            android:dependency="@string/settings_key_custom_resolution"
            android:dialogTitle="@string/settings_display_height_title"
            android:inputType="number"
            android:key="@string/settings_custom_height_key"
            android:title="@string/settings_display_height_title" />

        <EditTextPreference
            android:dependency="@string/settings_key_custom_resolution"
            android:dialogTitle="@string/settings_dpi_title"
            android:inputType="number"
            android:key="@string/settings_custom_dpi_key"
            android:title="@string/settings_dpi_title" />

        <ListPreference
            android:dependency="@string/settings_key_custom_resolution"
            android:entries="@array/display_presets"
            android:entryValues="@array/display_presets"
            android:key="@string/settings_custom_preset_key"
            android:title="@string/settings_display_preset_title" />

        <Preference
            android:key="@string/settings_key_restore_defaults"
            android:summary="@string/settings_restore_defaults_summary"
            android:title="@string/settings_restore_defaults_title" />

        <ListPreference
            android:defaultValue="@string/settings_fps_default"
            android:entries="@array/fps_choices"
            android:entryValues="@array/fps_values"
            android:key="@string/settings_key_fps_cap"
            android:summary="@string/settings_fps_summary"
            android:title="@string/settings_fps_title" />

        <Preference
            android:enabled="false"
            android:key="@string/settings_key_restart_note"
            android:selectable="false"
            android:summary="@string/settings_restart_required_note" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_advanced">


        <Preference
            android:key="@string/settings_key_replace_rom"
            android:summary="@string/settings_replace_rom_summary"
            android:title="@string/settings_key_replace_rom" />

        <Preference
            android:key="@string/settings_key_factory_reset"
            android:summary="@string/settings_factory_reset_summary"
            android:title="@string/settings_key_factory_reset" />

    </PreferenceCategory>


    <PreferenceCategory android:title="@string/settings_category_other">

        <Preference
            android:key="@string/settings_key_sendlog"
            android:summary="@string/settings_sendlog_summary"
            android:title="@string/settings_key_sendlog" />

        <Preference
            android:key="@string/settings_key_donate"
            android:summary="@string/settings_donate_summary"
            android:title="@string/settings_key_donate" />

        <Preference
            android:key="@string/settings_key_about"
            android:title="@string/settings_key_about" />
    </PreferenceCategory>

</PreferenceScreen>